{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/threebody/m5a_long_run.schema.json",
  "title": "Three Body Planet P0-M5A segmented IAS15 run configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "backend", "time", "segmentation", "checkpoint",
    "resources", "resume", "epsilon", "collision", "encounter", "escape",
    "require_positive_radius", "softening_m"
  ],
  "properties": {
    "schema_version": {"const": "0.6.0"},
    "backend": {"const": "rebound_ias15"},
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_time_s", "end_time_s", "output_interval_s"],
      "properties": {
        "start_time_s": {"type": "number"},
        "end_time_s": {"type": "number"},
        "output_interval_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "segmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulated_duration_s"],
      "properties": {
        "simulated_duration_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulation_interval_s", "wall_interval_s", "retain_count"],
      "properties": {
        "simulation_interval_s": {"type": "number", "exclusiveMinimum": 0},
        "wall_interval_s": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "retain_count": {"type": "integer", "minimum": 2, "maximum": 10000}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wall_seconds_per_invocation", "max_segments", "max_samples",
        "max_checkpoint_bytes"
      ],
      "properties": {
        "max_wall_seconds_per_invocation": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "max_segments": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_samples": {"type": "integer", "minimum": 2, "maximum": 100000000},
        "max_checkpoint_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1099511627776
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_same_rebound_version", "require_same_platform",
        "verify_all_committed_hashes"
      ],
      "properties": {
        "require_same_rebound_version": {"type": "boolean"},
        "require_same_platform": {"type": "boolean"},
        "verify_all_committed_hashes": {"type": "boolean"}
      }
    },
    "epsilon": {"type": "number", "minimum": 1e-15, "maximum": 1e-4},
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"const": "terminate"}}
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "threshold_mode"],
      "properties": {
        "enabled": {"type": "boolean"},
        "threshold_mode": {"enum": ["absolute_m", "radius_multiple"]},
        "distance_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "radius_multiplier": {"type": ["number", "null"], "exclusiveMinimum": 1}
      }
    },
    "escape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "boundary_radius_m", "require_outward_velocity",
        "require_positive_specific_energy", "minimum_duration_s"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "boundary_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "require_outward_velocity": {"type": "boolean"},
        "require_positive_specific_energy": {"type": "boolean"},
        "minimum_duration_s": {"type": "number", "minimum": 0}
      }
    },
    "require_positive_radius": {"type": "boolean"},
    "softening_m": {"const": 0.0}
  }
}
