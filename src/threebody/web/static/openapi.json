{
  "openapi": "3.1.0",
  "info": {
    "title": "Three Body Planet P0 local world science console",
    "version": "0.7.1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Local task-service health"
          }
        }
      }
    },
    "/api/v1/runs": {
      "get": {
        "operationId": "listRuns",
        "responses": {
          "200": {
            "description": "Committed run summaries"
          }
        }
      },
      "post": {
        "operationId": "startRun",
        "description": "Start real M5A integration in one bounded single-user worker",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "run_id",
                  "initial_state",
                  "settings"
                ],
                "properties": {
                  "run_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]{1,128}$"
                  },
                  "initial_state": {
                    "type": "object"
                  },
                  "settings": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted for asynchronous execution; not a claim of physical completion"
          },
          "422": {
            "description": "Invalid configuration or duplicate run"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/manifest": {
      "get": {
        "operationId": "getRunManifests",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unmodified committed manifests"
          },
          "404": {
            "description": "Run not found"
          }
        }
      }
    },
    "/api/v1/experiments/validate": {
      "post": {
        "operationId": "validateExperiment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "config"
                ],
                "properties": {
                  "config": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Strictly resolved configuration and SHA-256"
          },
          "422": {
            "description": "Validation errors"
          }
        }
      }
    },
    "/api/v1/jobs/{run_id}": {
      "get": {
        "operationId": "getJob",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Worker phase plus independently authoritative archived physics state"
          },
          "404": {
            "description": "No job known to this server process"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/pause": {
      "post": {
        "operationId": "pauseRun",
        "description": "Cooperatively request pause at the next safe segment boundary",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Control request accepted, not yet necessarily physically applied"
          },
          "422": {
            "description": "Invalid task state"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/resume": {
      "post": {
        "operationId": "resumeRun",
        "description": "Resume a durable PAUSED M5A run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Control request accepted, not yet necessarily physically applied"
          },
          "422": {
            "description": "Invalid task state"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/cancel": {
      "post": {
        "operationId": "cancelRun",
        "description": "Cooperatively request cancel at the next safe segment boundary",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Control request accepted, not yet necessarily physically applied"
          },
          "422": {
            "description": "Invalid task state"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/trajectory": {
      "get": {
        "operationId": "getCommittedTrajectoryRange",
        "description": "M5A verified immutable segments; actual samples, no extrapolation, bounded display reduction",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            }
          },
          {
            "name": "start_s",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Inclusive physical time in SI seconds"
          },
          {
            "name": "end_s",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Inclusive physical time in SI seconds"
          },
          {
            "name": "max_points",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 2,
              "maximum": 2000,
              "default": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Actual four-body positions at selected committed sample times"
          },
          "404": {
            "description": "No such run"
          },
          "422": {
            "description": "Invalid query or science archive fails verification"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/events": {
      "get": {
        "operationId": "getCommittedDynamicsEvents",
        "description": "Committed M5A dynamics events, escape candidates are not proven permanent escape",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            }
          },
          {
            "name": "start_s",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Inclusive physical time in SI seconds"
          },
          {
            "name": "end_s",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Inclusive physical time in SI seconds"
          }
        ],
        "responses": {
          "200": {
            "description": "Up to 10000 real dynamics events in the interval"
          },
          "404": {
            "description": "No such run"
          },
          "422": {
            "description": "Invalid/corrupt archive or range too large"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/environment": {
      "get": {
        "operationId": "getVerifiedDerivedLongEnvironment",
        "description": "M5A source-verified, independently archived M3 physical radiation/C0/C1 postprocessor data. Source and artifact hashes must match; no extrapolation. Derived separately by CLI world thermal-long.",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_s",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "end_s",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_points",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 2,
              "maximum": 2000,
              "default": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified time-aligned M5A-derived flux, C0 and C1 rows"
          },
          "404": {
            "description": "Missing source run or derived environment archive"
          },
          "422": {
            "description": "Invalid query, source provenance or artifact integrity"
          }
        }
      }
    },
    "/api/v1/worlds/preset": {
      "get": {
        "operationId": "getG21WebPreset",
        "responses": {
          "200": {
            "description": "Editable strict G2.1 preset JSON"
          }
        }
      }
    },
    "/api/v1/worldsets": {
      "get": {
        "operationId": "listWorldsets",
        "responses": {
          "200": {
            "description": "Immutable local generated worldset manifests"
          }
        }
      },
      "post": {
        "operationId": "generateWorldset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "config",
                  "count"
                ],
                "properties": {
                  "config": {
                    "type": "object"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Generated immutable deterministic candidates, including failed/terminal states"
          },
          "422": {
            "description": "Invalid generator configuration"
          }
        }
      }
    },
    "/api/v1/worlds/run": {
      "post": {
        "operationId": "startSelectedWorld",
        "description": "Pick existing verified G2.1 candidate and start real M5A IAS15 job for bounded SI duration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "batch_id",
                  "candidate_index",
                  "run_id",
                  "duration_s",
                  "output_interval_s"
                ],
                "properties": {
                  "batch_id": {
                    "type": "string"
                  },
                  "candidate_index": {
                    "type": "integer"
                  },
                  "run_id": {
                    "type": "string"
                  },
                  "duration_s": {
                    "type": "number",
                    "minimum": 60,
                    "maximum": 315576000
                  },
                  "output_interval_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted; physical completion not implied"
          },
          "422": {
            "description": "Missing/unsafe candidate or invalid time plan"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/outcome": {
      "get": {
        "operationId": "getM5ADerivedM4Outcome",
        "description": "Verified M5A-derived M4 classification and time-aligned events. No old M2 fake hashes.",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified M4 classification, statistics, event timeline"
          },
          "404": {
            "description": "Derived outcome unavailable"
          },
          "422": {
            "description": "Provenance or integrity check failed"
          }
        }
      }
    },
    "/api/v1/experiments/compare": {
      "get": {
        "operationId": "compareVerifiedRuns",
        "description": "Provenance-verified one to eight runs; missing thermal/outcome remains explicit; report contains immutable digest",
        "parameters": [
          {
            "in": "query",
            "name": "runs",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated distinct run IDs, max eight"
          }
        ],
        "responses": {
          "200": {
            "description": "Verified multi-world physical comparison / JSON report"
          },
          "404": {
            "description": "Unknown run"
          },
          "422": {
            "description": "Invalid request or corrupted scientific source"
          }
        }
      }
    },
    "/api/v1/experiments/report": {
      "get": {
        "operationId": "exportVerifiedScienceReport",
        "description": "Provenance-verified one to eight runs; missing thermal/outcome remains explicit; report contains immutable digest",
        "parameters": [
          {
            "in": "query",
            "name": "runs",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated distinct run IDs, max eight"
          }
        ],
        "responses": {
          "200": {
            "description": "Verified multi-world physical comparison / JSON report"
          },
          "404": {
            "description": "Unknown run"
          },
          "422": {
            "description": "Invalid request or corrupted scientific source"
          }
        }
      }
    },
    "/api/v1/planet-scenarios": {
      "post": {
        "operationId": "computeReadOnlyPlanetScenario",
        "summary": "Read-only parameterized planet experiment from an exact committed sample",
        "description": "Does not modify science archives. Inputs are assumptions, not inferred composition. Hazard rates require an event definition; collisions and unsupported regimes are rejected.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "run_id",
                  "parameters"
                ],
                "properties": {
                  "run_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]{1,128}$"
                  },
                  "parameters": {
                    "$ref": "#/components/schemas/PlanetScenarioV1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned parameter experiment with source hashes, assumptions, region grid and geometric star directions"
          },
          "404": {
            "description": "Unknown archive"
          },
          "422": {
            "description": "Invalid parameters, unsupported approximation or invalid scientific source"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PlanetScenarioV1": {
        "additionalProperties": false,
        "properties": {
          "t_s": {
            "minimum": 0,
            "title": "T S",
            "type": "number"
          },
          "seed": {
            "default": 42,
            "maximum": 4294967295,
            "minimum": 0,
            "title": "Seed",
            "type": "integer"
          },
          "albedo": {
            "default": 0.3,
            "maximum": 1,
            "minimum": 0,
            "title": "Albedo",
            "type": "number"
          },
          "emissivity": {
            "default": 1.0,
            "exclusiveMinimum": 0,
            "maximum": 1,
            "title": "Emissivity",
            "type": "number"
          },
          "optical_depth": {
            "default": 0.0,
            "maximum": 20,
            "minimum": 0,
            "title": "Optical Depth",
            "type": "number"
          },
          "core_temperature_k": {
            "default": 4000.0,
            "maximum": 20000,
            "minimum": 0,
            "title": "Core Temperature K",
            "type": "number"
          },
          "mantle_thickness_m": {
            "default": 2900000.0,
            "minimum": 1,
            "title": "Mantle Thickness M",
            "type": "number"
          },
          "conductivity_w_m_k": {
            "default": 3.0,
            "maximum": 100,
            "minimum": 0,
            "title": "Conductivity W M K",
            "type": "number"
          },
          "atmosphere_mass_kg": {
            "default": 5.15e+18,
            "maximum": 1e+26,
            "minimum": 0,
            "title": "Atmosphere Mass Kg",
            "type": "number"
          },
          "molar_mass_kg_mol": {
            "default": 0.029,
            "exclusiveMinimum": 0.001,
            "maximum": 0.3,
            "title": "Molar Mass Kg Mol",
            "type": "number"
          },
          "oxygen_mole_fraction": {
            "default": 0.0,
            "maximum": 1,
            "minimum": 0,
            "title": "Oxygen Mole Fraction",
            "type": "number"
          },
          "water_vapor_mole_fraction": {
            "default": 0.0,
            "maximum": 1,
            "minimum": 0,
            "title": "Water Vapor Mole Fraction",
            "type": "number"
          },
          "carbon_dioxide_mole_fraction": {
            "default": 0.0,
            "maximum": 1,
            "minimum": 0,
            "title": "Carbon Dioxide Mole Fraction",
            "type": "number"
          },
          "argon_mole_fraction": {
            "default": 0.0,
            "maximum": 1,
            "minimum": 0,
            "title": "Argon Mole Fraction",
            "type": "number"
          },
          "surface_water_kg": {
            "default": 1.4e+21,
            "maximum": 1e+26,
            "minimum": 0,
            "title": "Surface Water Kg",
            "type": "number"
          },
          "relief_m": {
            "default": 18000.0,
            "exclusiveMinimum": 0,
            "maximum": 100000.0,
            "title": "Relief M",
            "type": "number"
          },
          "terrain_shape_exponent": {
            "default": 0.72,
            "minimum": 0.5,
            "maximum": 1.5,
            "title": "Terrain Shape Exponent",
            "type": "number"
          },
          "contour_level_count": {
            "default": 24,
            "minimum": 20,
            "maximum": 30,
            "title": "Contour Level Count",
            "type": "integer"
          },
          "wind_range_fraction_min": {
            "default": 0.25,
            "minimum": 0,
            "maximum": 1,
            "title": "Wind Range Fraction Min",
            "type": "number"
          },
          "wind_range_fraction_max": {
            "default": 0.9,
            "exclusiveMinimum": 0,
            "maximum": 1.5,
            "title": "Wind Range Fraction Max",
            "type": "number"
          },
          "rotation_rate_rad_s": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rotation Rate Rad S"
          },
          "rotation_axis": {
            "anyOf": [
              {
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rotation Axis"
          },
          "longitude_phase_rad": {
            "default": 0.0,
            "title": "Longitude Phase Rad",
            "type": "number"
          },
          "latitude_deg": {
            "default": 0.0,
            "maximum": 89,
            "minimum": -89,
            "title": "Latitude Deg",
            "type": "number"
          },
          "longitude_deg": {
            "default": 0.0,
            "maximum": 180,
            "minimum": -180,
            "title": "Longitude Deg",
            "type": "number"
          },
          "observer_height_m": {
            "default": 2.0,
            "maximum": 100000.0,
            "minimum": 1,
            "title": "Observer Height M",
            "type": "number"
          },
          "horizon_years": {
            "default": 1.0,
            "exclusiveMinimum": 0,
            "maximum": 1000,
            "title": "Horizon Years",
            "type": "number"
          },
          "hazard_definition": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hazard Definition"
          },
          "hazard_rates_per_year": {
            "additionalProperties": {
              "maximum": 1000000.0,
              "minimum": 0,
              "type": "number"
            },
            "maxProperties": 1152,
            "title": "Hazard Rates Per Year",
            "type": "object"
          }
        },
        "required": [
          "t_s"
        ],
        "title": "PlanetScenario",
        "type": "object"
      }
    }
  }
}
