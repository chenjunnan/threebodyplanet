{
  "openapi": "3.1.0",
  "info": {"title": "Three Body Planet read-only science console", "version": "0.1.0"},
  "servers": [{"url": "/"}],
  "paths": {
    "/api/v1/health": {"get": {"operationId": "health", "responses": {"200": {"description": "Read-only service health"}}}},
    "/api/v1/runs": {"get": {"operationId": "listRuns", "responses": {"200": {"description": "Committed run summaries"}}}},
    "/api/v1/runs/{run_id}/manifest": {
      "get": {
        "operationId": "getRunManifests",
        "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}}],
        "responses": {"200": {"description": "Unmodified committed manifests"}, "404": {"description": "Run not found"}}
      }
    },
    "/api/v1/experiments/validate": {
      "post": {
        "operationId": "validateExperiment",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["config"], "properties": {"config": {"type": "object"}}, "additionalProperties": false}}}},
        "responses": {"200": {"description": "Strictly resolved configuration and SHA-256"}, "422": {"description": "Validation errors"}}
      }
    }
  }
}
